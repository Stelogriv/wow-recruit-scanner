# Neon Postgres — set automatically by Vercel → Storage → Create → Neon
DATABASE_URL=
# Warcraft Logs API client (warcraftlogs.com/api/clients)
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
# Password you and the GM use to sign in (letters and numbers)
APP_PASSWORD=
# Key the browser extension sends (letters and numbers; also typed into the extension options)
INGEST_KEY=
# Key for /api/probe?key=... (letters and numbers)
PROBE_KEY=
